<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/config_hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Values are used for Pluto IIO, plutorx_ws raw CS8 playback, and IQ capture. Record IQ always writes CS8. Enter raw Hz values."
            android:textAppearance="?attr/textAppearanceBody2" />

        <TextView
            android:id="@+id/iq_source_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IQ source for scanner/playback algorithm"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <RadioGroup
            android:id="@+id/iq_source_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/iq_source_iio_radio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IIO" />

            <RadioButton
                android:id="@+id/iq_source_websocket_radio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WebSocket" />

        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/maia_host_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pluto WebSocket host"
            app:helperText="Example: 192.168.2.1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/maia_host_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:selectAllOnFocus="true"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/maia_port_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Pluto WebSocket port"
            app:helperText="Default: 7682">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/maia_port_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:selectAllOnFocus="true"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pluto_ws_path_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Pluto WebSocket path"
            app:helperText="Default: /iq">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pluto_ws_path_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:selectAllOnFocus="true"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pluto_ws_receive_buffer_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Pluto WS receive buffer ms"
            app:helperText="Low latency buffer: 50...150 ms">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pluto_ws_receive_buffer_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:selectAllOnFocus="true"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/sample_format_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="IQ sample format"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <RadioGroup
            android:id="@+id/sample_format_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/sample_format_cs16_radio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CS16" />

            <RadioButton
                android:id="@+id/sample_format_cs8_radio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CS8" />

        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/center_frequency_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Center frequency Hz"
            app:helperText="Example: 5885000000 for 5.885 GHz">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/center_frequency_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:selectAllOnFocus="true"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/sample_rate_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Sample rate Hz"
            app:helperText="Example: 25000000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/sample_rate_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:selectAllOnFocus="true"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/rf_bandwidth_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="RF bandwidth Hz"
            app:helperText="Example: 20000000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rf_bandwidth_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:selectAllOnFocus="true"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/gain_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="RX gain dB"
            app:helperText="Manual Pluto hardware gain">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gain_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal|numberSigned"
                android:selectAllOnFocus="true"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/capture_duration_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Capture duration seconds"
            app:helperText="Used only for Record IQ capture">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/capture_duration_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:selectAllOnFocus="true"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lo_offset_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="LO offset Hz"
            app:helperText="Actual RX LO = center frequency + offset">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lo_offset_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned"
                android:selectAllOnFocus="true"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/iq_correction_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hardware IQ imbalance correction (IQ)" />

        <CheckBox
            android:id="@+id/bbdc_correction_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hardware baseband DC removal (BBDC)" />

        <CheckBox
            android:id="@+id/rfdc_correction_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hardware RF DC removal (RFDC)" />

        <Button
            android:id="@+id/save_defaults_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save as defaults" />
    </LinearLayout>
</ScrollView>
