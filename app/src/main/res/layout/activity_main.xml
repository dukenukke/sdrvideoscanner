<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/main_menu_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="Main Menu" />

        <TextView
            android:id="@+id/current_menu_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="Selected: Pluto WS CS8"
            android:textSize="16sp" />

        <Button
            android:id="@+id/toggle_stats_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hide Stats" />
    </LinearLayout>

    <ImageView
        android:id="@+id/video_frame_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="0dp"
        android:adjustViewBounds="true"
        android:background="#111111"
        android:contentDescription="Decoded grayscale analog video frame"
        android:minHeight="260dp"
        android:scaleType="fitCenter" />

    <ScrollView
        android:id="@+id/stats_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <TextView
            android:id="@+id/sample_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            android:textIsSelectable="true"
            tools:text="CS16 diagnostics appear here" />
    </ScrollView>
</LinearLayout>
